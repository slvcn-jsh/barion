{
  "name": "barion",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.11",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:mobile": "expo start --dev-client --tunnel",
    "android": "expo start --android",
    "ios": "expo start --dev-client --tunnel",
    "ios:cloud:check": "npx eas-cli@latest simulator:availability",
    "ios:build:development": "npx eas-cli@latest build --platform ios --profile development-simulator",
    "ios:build:preview": "npx eas-cli@latest build --platform ios --profile preview-simulator",
    "eas:login": "npx eas-cli@latest login",
    "eas:link": "npx eas-cli@latest init",
    "web": "node scripts/start-web.js",
    "gateway": "python -m uvicorn services.ai_gateway.main:app --host 127.0.0.1 --port 8790",
    "benchmark:cards": "python -m services.card_benchmark",
    "benchmark:cards:dry": "python -m services.card_benchmark --dry-run",
    "test:benchmark": "python -m pytest services/card_benchmark/tests -q",
    "test:gateway": "python -m pytest services/ai_gateway/tests -q",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ai-fallback": "playwright test --config=playwright.ai-fallback.config.js",
    "check": "npm run typecheck && npm test"
  },
  "private": true
}
