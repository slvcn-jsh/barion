# Public routing metadata only. Expo inlines EXPO_PUBLIC_* values into client bundles.
# Never place provider API keys, tokens, or other credentials in EXPO_PUBLIC_* variables.

# Required only for PDF extraction in iOS/Android builds.
# Use HTTPS in production. A physical device cannot reach your computer through localhost.
EXPO_PUBLIC_BARION_INGESTION_URL=http://192.168.1.20:8787

# Optional AI gateway routing. Provider credentials must remain behind this server boundary.
EXPO_PUBLIC_BARION_AI_GATEWAY_URL=http://127.0.0.1:8790
EXPO_PUBLIC_BARION_AI_MODEL=gemini-2.5-flash
# Local/shared-client credential only; Expo embeds it in bundles. Use short-lived user tokens in production.
EXPO_PUBLIC_BARION_AI_GATEWAY_TOKEN=replace-with-development-token

# AI gateway server secrets and limits. Never expose these as EXPO_PUBLIC_*.
BARION_AI_GATEWAY_AUTH_TOKEN=replace-with-development-token
GEMINI_API_KEY=replace-with-provider-key
PRIMARY_GENERATION_PROVIDER=gemini
PRIMARY_GENERATION_MODEL=gemini-2.5-flash
BARION_AI_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
BARION_AI_PROVIDER_TIMEOUT_SECONDS=30
BARION_AI_MAX_REQUEST_BYTES=300000
BARION_AI_MAX_INPUT_CHARACTERS=180000

# Ingestion server-side comma-separated web origins.
BARION_ALLOWED_ORIGINS=http://localhost:8081
