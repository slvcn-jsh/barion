{
  "expo": {
    "name": "BARION",
    "slug": "barion",
    "description": "Medical learning, for real life. Learn today. Heal tomorrow.",
    "version": "1.0.0",
    "scheme": "barion",
    "orientation": "default",
    "icon": "./app/image/BARIONLOGO.png",
    "backgroundColor": "#F6F9FD",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barion.medstudy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./app/image/BARIONLOGO.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./app/image/BARIONLOGO.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#3B82F6",
          "defaultChannel": "barion-study-plan"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./app/image/BARIONLOGO.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#0F2D60",
            "image": "./app/image/BARIONLOGO.png"
          }
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "1adf52a3-ad90-4d75-adb7-d614abed0bca"
      }
    },
    "owner": "kuyajosh_15"
  }
}
